{
  "name": "ile-manga-pcvr",
  "version": "0.2.0",
  "private": true,
  "description": "Île Manga : jeu Windows et lanceur PCVR Quest 3",
  "main": "main.cjs",
  "scripts": {
    "stage": "node stage.cjs",
    "dist": "npm run stage && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "babylonjs": "^8.0.0",
    "babylonjs-loaders": "^8.0.0",
    "babylonjs-materials": "^8.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.ilemanga.pcvr",
    "productName": "Ile Manga PC",
    "asar": true,
    "compression": "normal",
    "artifactName": "Ile-Manga-PC-VR-v${version}-${arch}.${ext}",
    "directories": {"output": "../dist/pcvr"},
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [{"from": "../pc-site", "to": "game", "filter": ["**/*"]}],
    "win": {"target": [{"target": "portable", "arch": ["x64"]}]}
  }
}
