func build(owner: Node) -> void:
	owner_hf = owner
	main = owner.main
	pc = owner.pc
	name = "Activite_dome_v119"
	style = "dome"
	prefix = "da119_"
	var da: Node = owner.dome
	_rng.seed = 119119
	for k in da.cadres119:
		cadres[k] = da.cadres119[k]
	for k3 in cadres:
		var g: String = _groupe(str(k3))
		if not centres.has(g):
			centres[g] = (cadres[k3] as Transform3D).origin
	_decors119(da.kit)
	print("ILE_MANGA_V119: %d travailleurs et visiteurs dans les lieux du Dôme d'Azur" % _poster(POSTES119))


## Le Dôme est sous la mer : personne tant qu'il n'est pas affiché (à la surface, aux Strates).
func _cache() -> bool:
	return owner_hf.dome == null or not (owner_hf.dome as Node3D).is_visible_in_tree()


# =================================================================== les décors

func _decors119(kit) -> void:
	# le Bassin des Bathyscaphes : les nasses du vieux pêcheur, empilées près de lui (des cages rondes de
	# titane clair, leur fond sombre)
	if cadres.has("bassin"):
		var bx: Transform3D = cadres["bassin"]
		for e in [[-8.4, 1.4, 0.0], [-8.3, 2.15, 0.0], [-8.35, 1.75, 0.46]]:
			var p: Vector3 = bx * Vector3(float(e[0]), float(e[2]), float(e[1]))
			kit.cyl(Transform3D(Basis(), p), 0.3, 0.26, 0.04, "titane115_sombre", 12, true)
			for k in range(3):
				kit.ring(Transform3D(Basis(), p + Vector3.UP * (0.06 + k * 0.17)), 0.26, 0.3, 0.03, "titane115_clair", 12)
			kit.cyl(Transform3D(Basis(), p + Vector3.UP * 0.42), 0.3, 0.12, 0.03, "titane115_clair", 12, true)
		kit.col_cyl(bx * Vector3(-8.35, 0.0, 1.75), 0.75, 0.9)
	kit.commit()
