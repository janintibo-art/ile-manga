extends "res://scripts/hautefond_activite_v116.gd"
## V119 : la vie dans les lieux ouverts du Dôme d'Azur (comme à Hautefond, dans la Cité des Nuées et aux
## Strates : les gens viennent quand on approche, à leurs heures, et repartent quand on s'éloigne ;
## quelques-uns parlent). Les repères : dome_azur_v115.cadres119 (les corps : le style « dome », ceux des
## passants du Dôme) : la Gare d'Azur, la Place de la Perle et la Fontaine des Bulles, la terrasse de La
## Conque, le Comptoir des Courants, l'Atelier des Scaphandres, la cour de l'École des Abysses, le Jardin
## des Coraux, le perron du Conseil des Marées, la Promenade des Hublots, le Belvédère des Abysses, le Dôme
## des Serres, l'Institut des Abysses, le Grand Aquarium, le Bassin des Bathyscaphes.

## [lieu, rôle, position (repère du lieu), regard (degrés), pose, [heure de début, de fin], phrases, options]
## options : va (l'autre bout de son aller-retour), rond ([rayon, vitesse] autour de la position),
## phase, porte (ce qu'il porte), vr (aussi en VR), parle ([accueils], [[id, question, [réponses]]]),
## style (une autre allure).
const POSTES119 := [
	# --- la Place de la Perle (origine au pied de la Cheminée d'Air ; +X est, +Z sud ; l'anneau libre de r 14 à 16,5)
	["place", "homme", Vector3(8.3, 0.05, 0.0), -90.0, "holo", [6.5, 18.0], ["Débit d'air : parfait. Température : parfaite. Humeur du technicien : presque parfaite, il manque un chocolat.", "La Cheminée d'Air respire pour tout le Dôme. Moi, je vérifie qu'elle n'a pas le hoquet."],
		{"vr": true, "parle": [["Bonnes bulles ! Ne t'inquiète pas, je ne surveille pas les gens. Je surveille l'air qu'ils respirent. C'est plus calme.", "Bonjour ! Tu sens ce petit vent frais ? Il arrive tout droit de la surface. Il a fait cent quarante mètres pour te dire bonjour."],
			[["air", "Comment respire le Dôme ?", ["Par la Cheminée ! Tout en haut, sur la mer, une bouée-phare aspire l'air du ciel, et il descend jusqu'ici dans ce grand tube blanc. Les algues des Serres font le reste. Le Dôme a deux poumons : un tube et un jardin."]],
			["perle", "Et la Grande Perle ?", ["C'est notre soleil, enfilé sur la Cheminée comme une perle sur un collier. Blanche et dorée le jour, violette le soir. Elle ne brûle jamais les yeux. Les gens d'en haut la regardent longtemps, pour vérifier."]]]]}],
	["place", "femme", Vector3(4.2, 0.05, 7.2), -150.0, "observer", [9.0, 20.0], ["On est descendus de Hautefond ce matin. Mon mari dit que la Perle est plus jolie que le soleil. Je n'ose pas le répéter au soleil.", "Tout est blanc, tout brille, et personne ne court. Je crois que je vais rester un peu. Ou toujours."],
		{"vr": true, "parle": [["Bonnes bulles ! C'est comme ça qu'on dit, ici ? Je l'ai appris dans le Funiculaire. Je le dis à tout le monde, c'est trop joli.", "Bonjour ! Vous aussi, vous venez d'en haut ? On se reconnaît : on a tous la bouche ouverte."],
			[["voyage", "Le voyage était long ?", ["La cage de laiton, puis la bulle de verre dans son tube… Une raie est passée juste sous nos pieds ! J'ai crié. Elle n'a même pas répondu. Les raies sont très bien élevées."]],
			["impression", "Qu'est-ce qui vous plaît, ici ?", ["Tout le monde se dit bonjour, même les poissons, derrière le verre. Et une petite fille m'a demandé comment était le ciel. J'ai cherché mes mots longtemps. Je crois que je lui ai répondu : « Comme ta Perle, mais en plus grand et en plus mouillé. »"]]]]}],
	["place", "vieille", Vector3(-6.4, 0.05, 5.3), 130.0, "observer", [18.0, 22.0], ["Le soir, la Perle devient violette, et moi aussi : j'ai mis ma robe assortie. À mon âge, on a le droit d'être assortie à son soleil.", "Quatre-vingts ans que je la regarde changer de couleur. Je ne m'en lasse pas. Elle non plus, apparemment."], {}],
	["place", "homme", Vector3(15.0, 0.05, 0.0), -45.0, "marcher", [6.5, 11.0], ["Spiruline fraîche pour La Conque ! Josette la veut avant que la soupe se réveille.", "Pardon, ça passe ! Cette caisse est verte, elle sent la mer, et elle est très lourde. Comme mon oncle."], {"va": Vector3(10.6, 0.05, 10.6), "porte": "caisse"}],
	["place", "garcon", Vector3(0.0, 0.05, 0.0), 0.0, "marcher", [10.0, 19.0], ["Le premier qui fait le tour de la Place a gagné ! La Perle compte les points !", "Je suis un poisson-lanterne ! Je vais plus vite que toi, et en plus, je brille !"], {"rond": [15.0, 1.6], "vr": true}],
	["place", "fille", Vector3(0.0, 0.05, 0.0), 0.0, "marcher", [10.0, 19.0], ["Attends-moi ! Non, ne m'attends pas : je suis la Grande Chanteuse, je vais t'avaler ! Gentiment !", "Mila dit que le ciel n'a pas de bord. Alors on court jusqu'au bord de la Place. Ici, il y en a un."], {"rond": [15.0, 1.6], "phase": 3.1}],
	# --- la Fontaine des Bulles (même repère que la Place ; contre le rebord du bassin)
	["fontaine", "garcon", Vector3(6.5, 0.05, 3.75), -120.0, "pointer", [9.0, 19.0], ["Je chuchote mon vœu à une bulle, et elle le monte jusqu'à la surface. Le mien est très grand. J'espère que la bulle aussi.", "Celle-là ! La grosse bulle ! Elle a pris mon vœu ! Bon voyage, mon vœu !"], {"vr": true}],
	["fontaine", "femme", Vector3(-7.05, 0.05, 2.57), 110.0, "debout", [9.0, 19.0], ["Mon fils fait un vœu par bulle. Il en est à trois cents. La surface va être très encombrée.", "Le bruit de la fontaine, c'est le seul bruit de pluie qu'on ait, ici. Alors on vient l'écouter."], {}],
	["fontaine", "vieux", Vector3(-5.75, 0.05, -4.82), 50.0, "mains_dos", [7.0, 12.0], ["Chaque matin, je compte les bulles de la Fontaine. Je n'arrive jamais à la fin. C'est ce qui me garde jeune.", "Quand j'étais petit, on disait que les bulles allaient raconter au ciel ce qui se passait chez nous. Le ciel doit tout savoir, maintenant."], {"vr": true}],
	["fontaine", "femme", Vector3(5.75, 0.05, -4.82), -50.0, "bricoler", [6.5, 9.0], ["Je nettoie les buses de la Fontaine avant que la ville se réveille. Une buse bouchée, et les vœux restent coincés.", "Ce matin, j'ai trouvé un petit coquillage dans la buse numéro sept. Quelqu'un a voulu faire un vœu solide."], {}],
	# --- la Gare d'Azur (le quai ; +X vers le bout du quai, -Z vers la voie et les portes de verre)
	["gare", "femme", Vector3(4.2, 0.05, -1.2), -90.0, "pointer", [6.5, 22.0], ["Restez derrière la ligne bleue, s'il vous plaît ! La bulle arrive en douceur, mais elle arrive.", "Bienvenue au fond de la mer ! Bonnes bulles à tous ! Attention à la marche, et à la raie."],
		{"vr": true, "parle": [["Bonnes bulles ! Agente de quai de la Gare d'Azur. Si vous cherchez Marius, il est aux commandes. Si vous l'entendez chanter, c'est qu'il arrive.", "Bonjour ! Premier voyage au Dôme ? Ça se voit : vous regardez le plafond. Tout le monde regarde le plafond."],
			[["ligne", "La Ligne a vraiment été fermée ?", ["Douze ans ! Douze ans de travaux sur le tube de verre. Pendant ce temps, seules les lettres et la spiruline voyageaient. Maintenant, il y a trente descentes par jour, et des gens d'en haut qui pleurent de joie sur le quai. Moi aussi, un peu. Ne le dites pas."]],
			["marius", "Qui conduit le Funiculaire ?", ["Marius Trident, le chef de gare. Il parle à sa cabine : « Doucement, ma bulle. » Et il chante dans le tunnel. Le tunnel a une très bonne acoustique. Les voyageurs aussi, maintenant : ils connaissent toutes les paroles."]]]]}],
	["gare", "femme", Vector3(-4.5, 0.05, -1.0), 180.0, "debout", [8.0, 20.0], ["J'ai pris trois photos de la raie, deux de la Perle et une de mon pouce. La plus réussie, c'est le pouce.", "Ma grand-mère disait qu'il y avait une ville au fond de la mer. Personne ne la croyait. Je vais lui envoyer une carte postale très mouillée."],
		{"porte": "valise", "vr": true}],
	["gare", "homme", Vector3(-3.7, 0.05, -1.3), 170.0, "bras_croises", [8.0, 20.0], ["Ma femme veut rester. Moi aussi. Mais quelqu'un doit nourrir le chat, en haut.", "Le Funiculaire descend en chantant et remonte en sifflotant. C'est Marius. Il ne sait pas faire autrement."], {}],
	["gare", "garcon", Vector3(-1.0, 0.05, -1.3), 180.0, "pointer", [8.0, 19.0], ["La bulle ! La bulle arrive ! Elle a des poissons tout autour, comme une escorte !", "Quand je serai grand, je conduirai le Funiculaire. Et je chanterai plus juste que Marius. Ce n'est pas difficile, dit Papa."], {"vr": true}],
	["gare", "homme", Vector3(-5.5, 0.05, 1.0), 90.0, "marcher", [6.5, 22.0], ["Bagages ! Bagages pour la bulle ! Les valises d'en haut sont toujours plus lourdes : elles sont pleines de souvenirs.", "Attention, chariot qui passe ! Il roule doucement, comme tout le monde ici."], {"va": Vector3(4.5, 0.05, 1.0), "porte": "chariot"}],
	# --- la terrasse de La Conque (+Z vers la Place ; les tables et leurs tabourets sont aux habitants)
	["conque", "homme", Vector3(-3.0, 0.05, -1.6), 50.0, "marcher", [7.0, 22.0], ["Chaud devant ! Soupe de salicorne pour la table du hublot !", "Une limonade bleue, une ! Ne la regardez pas trop longtemps, elle rougit. Enfin, elle bleuit."],
		{"va": Vector3(3.0, 0.05, 2.6), "porte": "plateau", "vr": true,
		"parle": [["Bonnes bulles ! Asseyez-vous où vous voulez : ici, toutes les tables ont vue sur la mer. C'est la seule chose qu'on ne fait pas payer.", "Bonjour ! Vous avez faim ? Josette le sait déjà. Elle le sent depuis la cuisine."],
			[["menu", "Qu'est-ce qui est bon, aujourd'hui ?", ["La soupe de salicorne, le poisson des nasses du Bassin, les galettes qui croustillent comme des vagues, et le chocolat des abysses, noir comme la Fosse. Pas une goutte de boisson forte : Josette dit que sous la mer, on garde les idées aussi claires que l'eau."]],
			["limonade", "Pourquoi la limonade est bleue ?", ["Du citron des Lampes, l'eau fraîche de la Cheminée, et une cuillère de spiruline. Les enfants d'en haut la regardent longtemps avant de la boire. Ils croient que c'est de la mer en bouteille. Un petit peu, oui."]]]]}],
	["conque", "femme", Vector3(0.0, 0.05, 3.0), 180.0, "boire", [8.0, 21.0], ["Un chocolat des abysses ! Il est si noir que j'ai perdu ma cuillère dedans. Elle est revenue toute contente.", "Ma limonade est bleue comme le Bassin. J'ai l'impression de boire un petit morceau de vacances."], {"vr": true}],
	["conque", "vieux", Vector3(-3.0, 0.05, 3.2), 150.0, "rire", [11.0, 15.0], ["Ha ha ! Ernest a encore demandé des nouvelles à un touriste. Le touriste lui a demandé des nouvelles en retour. Ils sont là depuis une heure.", "Josette m'a resservi trois fois. Je n'ai rien demandé. Elle lit dans les ventres."], {}],
	["conque", "fille", Vector3(-6.6, 0.05, 1.0), 90.0, "boire", [15.0, 18.0], ["La limonade bleue, c'est mon goûter préféré. Je fais des bulles avec la paille, comme la Fontaine.", "Josette dit que si on boit trop vite, on fait des vagues dans son ventre. J'ai essayé. C'est vrai."], {}],
	# --- le Comptoir des Courants (plancher à +0,25 ; le marchand derrière le comptoir rond)
	["comptoir", "homme", Vector3(-1.0, 0.3, 3.6), 153.0, "debout", [8.0, 18.0], ["Je viens chercher une corde, et Ernest me pose dix questions sur Hautefond. Je ne sais même pas où j'habite, moi.", "Un coquillage qui chante, s'il vous plaît. Pour ma fille. Et un autre pour moi. Pour vérifier que c'est le même chant."], {"vr": true}],
	["comptoir", "vieille", Vector3(1.2, 0.3, 4.0), -153.0, "bras_croises", [8.0, 12.0], ["J'attends ma perle d'Azur. Lou la rapporte de la Fosse avec le Petit Plongeon. Les huîtres prennent leur temps, et moi aussi.", "Ernest a lu les nouvelles du jour sur son tableau. La Grande Chanteuse va bien. Moi aussi, merci."], {}],
	["comptoir", "garcon", Vector3(0.0, 0.3, 5.2), 180.0, "pointer", [13.0, 18.0], ["Celui-là ! Le coquillage tout en spirale ! Il chante plus fort que les autres !", "Ernest m'a demandé s'il y avait des nouvelles à l'école. J'ai dit que Mila avait perdu une dent. Il l'a écrit dans son Grand Cahier."], {}],
	["comptoir", "garcon", Vector3(1.5, 0.3, -0.8), 0.0, "bricoler", [8.0, 18.0], ["Je range les coquillages par taille, puis par couleur, puis par chanson. La troisième, c'est la plus longue.", "Trois cent soixante-dix-huit ! Ernest en a un de plus. Il ne le sait pas encore. Surprise !"],
		{"vr": true, "parle": [["Bonnes bulles ! Je suis l'apprenti d'Ernest. Il m'apprend le commerce. Surtout le commerce des nouvelles. Tu en as une ?", "Bonjour ! Tu veux écouter un coquillage ? Colle-le à ton oreille. Chut… Tu entends ? C'est la Grande Chanteuse. Ou ton oreille. On ne sait jamais."],
			[["coquillages", "Pourquoi certains coquillages chantent ?", ["C'est leur forme, en spirale. Quand on les approche de l'oreille, on entend la mer, et parfois la Chanteuse. Le Professeur Benthos dit que c'est le bruit de ton propre sang. Mais il en a acheté trois. Alors, on se doute."]],
			["ernest", "Ernest est un bon patron ?", ["Le meilleur ! Il me paie en pièces et en histoires. Les pièces, je les range. Les histoires, je les raconte à l'école, et tout le monde m'écoute. Même Madame Odile. Surtout quand ça parle du Bourgmestre de Hautefond."]]]]}],
	["comptoir", "femme", Vector3(-4.8, 0.3, -1.5), 129.0, "observer", [9.0, 19.0], ["Des cordes, des ressorts, des perles et des coquillages. C'est la boutique la plus mélangée que j'aie jamais vue. J'adore.", "Je cherche un souvenir pour ma sœur. Elle a tout. Mais elle n'a pas de coquillage qui chante."], {}],
	# --- l'Atelier des Scaphandres (dedans vers -Z, plancher à +0,24 ; devant, le comptoir et son vendeur)
	["atelier", "homme", Vector3(1.5, 0.29, -8.5), 16.0, "bricoler", [7.0, 19.0], ["Joint numéro quarante-trois : impeccable. Yolande va quand même le revérifier. C'est sa façon de dire bonjour.", "Un scaphandre bien réglé, ça ne fuit pas, ça ne grince pas, et ça ne chante pas. Celui-là chante. Je cherche pourquoi."],
		{"vr": true, "parle": [["Bonnes bulles ! Ne touche pas au manomètre, s'il te plaît. Il est susceptible. Yolande aussi, un peu.", "Bonjour ! Tu veux essayer un casque ? Il est un peu grand. Tu vas ressembler à un poisson-globe très curieux."],
			[["scaphandres", "À quoi servent les scaphandres ?", ["À sortir réparer le verre, dehors, quand il faut. On ne sort jamais seul, jamais longtemps, et toujours avec trois vérifications. Yolande en fait quatre. La quatrième, c'est pour le plaisir."]],
			["yolande", "Yolande est sévère ?", ["Elle tapote chaque vitre du Dôme avec son petit marteau. « Ting », c'est une vitre en bonne santé. « Tonk », c'est une vitre fatiguée. Cette semaine, que des « ting ». Elle a souri deux fois. C'est un record."]]]]}],
	["atelier", "femme", Vector3(-1.5, 0.29, -2.0), 180.0, "marcher", [7.5, 18.0], ["Des joints neufs pour la Promenade des Hublots ! Ils sont tout souples, comme des bonbons. Ne les mangez pas.", "Pardon, ça passe ! Cette caisse pèse le poids de quarante-deux écrous. Je les ai comptés. Deux fois."], {"va": Vector3(-2.0, 0.05, 2.5), "porte": "caisse", "vr": true}],
	["atelier", "homme", Vector3(0.5, 0.29, -2.5), 180.0, "bras_croises", [9.0, 17.0], ["J'attends mon scaphandre. Yolande a dit « dix minutes ». Chez elle, ça veut dire dix minutes et quatre vérifications.", "Mon casque sifflait quand je tournais la tête à gauche. Alors je ne tournais plus qu'à droite. J'ai fini par revenir au même endroit."], {}],
	["atelier", "garcon", Vector3(-4.0, 0.05, 3.0), 180.0, "pointer", [10.0, 18.0], ["Regarde les scaphandres ! On dirait des chevaliers ! Des chevaliers de la mer, avec des bulles !", "Quand je serai grand, je réparerai le verre du Dôme. Dehors ! Avec les poissons qui me regardent travailler."], {"vr": true}],
	["atelier", "femme", Vector3(2.5, 0.05, 2.4), 180.0, "debout", [9.0, 18.0], ["Je viens d'en haut acheter un masque de plongée. Le vendeur m'a dit qu'ici, c'est trop profond pour plonger. Je le prends quand même, pour la baignoire.", "Tout est si propre, ici. Même les clés à molette brillent. Chez moi, elles rouillent dans un tiroir."], {}],
	# --- la cour de l'École des Abysses (+Z vers la Place ; la classe vers -Z)
	["ecole", "femme", Vector3(0.0, 0.05, -2.8), 0.0, "enseigner", [8.0, 16.5], ["Doucement sur le toboggan ! Un à la fois ! Et on ne glisse pas sur le ventre, Malo !", "La récréation, c'est pour respirer. Ici, l'air vient du ciel : respirez-le bien, il a fait un long voyage."],
		{"vr": true, "parle": [["Bonnes bulles ! Je surveille la récréation pendant que Madame Odile prépare la leçon de l'après-midi. Aujourd'hui : les nuages. Les enfants n'y croient pas tout à fait.", "Bonjour ! Attention aux petits pieds qui courent : ici, la récréation, c'est sérieux."],
			[["ciel", "Les enfants ont vu le ciel ?", ["La plupart, jamais. Ils sont nés sous la Perle. Alors on leur apprend le ciel comme une langue étrangère : le bleu, les nuages, la pluie qui tombe du haut. Depuis que la Ligne a rouvert, certains vont le voir en vrai. Ils reviennent en parlant très fort."]],
			["lecon", "Qu'est-ce qu'ils apprennent ?", ["À lire, à compter, à reconnaître les chants de la Grande Chanteuse, et à réparer un joint de hublot. Ici, on apprend tout ce qui sert. Et le reste aussi, pour le plaisir."]]]]}],
	["ecole", "garcon", Vector3(1.9, 0.05, -0.8), 0.0, "marcher", [8.0, 16.5], ["Je suis le Petit Plongeon ! Je descends, je descends ! Bloup !", "Tu ne m'attraperas pas ! Je suis une raie ! Les raies sont très rapides quand elles veulent !"], {"rond": [2.3, 1.5], "vr": true}],
	["ecole", "fille", Vector3(1.9, 0.05, -0.8), 0.0, "marcher", [8.0, 16.5], ["Je suis la Grande Chanteuse ! Ouuuuh ! … C'est comme ça qu'elle chante, je te jure !", "Si tu me touches, tu deviens une méduse ! Et les méduses ne peuvent pas courir !"], {"rond": [2.3, 1.5], "phase": 3.1}],
	["ecole", "fille", Vector3(-4.5, 0.05, 0.8), 77.0, "pointer", [8.0, 16.5], ["Le toboggan, c'est comme le Funiculaire, mais en plus rapide et sans Marius qui chante.", "Mila m'a dit que, là-haut, le plafond est si loin qu'on ne le voit pas. Je ne sais pas si c'est vrai. Elle non plus."], {}],
	["ecole", "femme", Vector3(1.2, 0.05, 2.2), 180.0, "debout", [16.0, 18.0], ["J'attends mon fils. Il va me raconter sa journée en courant. Je ne comprendrai que la moitié. Ce sera la meilleure moitié.", "Ce matin, il m'a demandé si les nuages avaient des arêtes. J'ai dit non. Il a eu l'air déçu."], {"vr": true}],
	# --- le Jardin des Coraux (+X est, +Z sud ; les vasques de corail lumineux)
	["jardin", "homme", Vector3(0.6, 0.05, -4.0), -8.0, "jardiner", [6.5, 12.0], ["Doucement, petit corail. Tu pousses d'un millimètre par semaine : on a tout notre temps.", "Celui-ci brille rose quand je lui parle. Celui-là brille bleu quand je me tais. Je crois qu'il préfère le silence."],
		{"vr": true}],
	["jardin", "vieux", Vector3(-6.8, 0.05, 0.6), 147.0, "observer", [9.0, 18.0], ["Ce corail-là, je l'ai vu planter quand j'avais dix ans. Il est devenu bien plus grand que moi. Enfin, en largeur.", "Le matin, je viens dire bonjour aux coraux. Ils ne répondent pas. Mais ils brillent un peu plus. Ça me suffit."], {}],
	["jardin", "femme", Vector3(7.0, 0.05, 1.0), -90.0, "peindre", [10.0, 17.0], ["Je peins les coraux. Le problème, c'est qu'ils changent de couleur pendant que je les peins. Mon tableau a déjà trois couleurs de trop.", "Un peu de rose, un peu de bleu nuit, et une pointe de nacre. Voilà le Dôme, en un seul coup de pinceau."], {"vr": true}],
	["jardin", "garcon", Vector3(2.4, 0.05, 2.4), -135.0, "pointer", [10.0, 18.0], ["Celui-là clignote ! Il me fait un clin d'œil ! … Ou alors, il a une poussière.", "Si je touche le corail, il brille plus fort ? … Non, Maman a dit qu'on ne touche pas. Je regarde très fort, alors."], {}],
	["jardin", "vieille", Vector3(8.8, 0.05, -6.0), 0.0, "marcher", [7.0, 10.0], ["Ma promenade du matin : l'allée du Jardin, deux fois, et un bonjour à chaque corail. Ça fait beaucoup de bonjours.", "Le docteur m'a dit de marcher. Il n'a pas dit vite. Alors je marche lentement, très longtemps."], {"va": Vector3(8.8, 0.05, 6.0), "vr": true}],
	# --- le perron du Conseil des Marées (le dessus à +0,6 ; le hall à +0,12)
	["conseil", "homme", Vector3(-3.5, 0.17, -7.5), 90.0, "marcher", [8.0, 18.0], ["Les registres des Marées ! Pardon, les registres passent ! Ils sont plus anciens que moi, et beaucoup plus lourds.", "La Présidente veut tout relire avant ce soir. Même les virgules. Surtout les virgules."],
		{"porte": "dossiers", "vr": true, "va": Vector3(3.5, 0.17, -7.5),
		"parle": [["Bonnes bulles ! Greffier du Conseil des Marées. Si vous venez déposer une demande, c'est au bureau. Si vous venez déposer un compliment, c'est aussi au bureau. Il y en a beaucoup, en ce moment.", "Bonjour ! Vous visitez ? La salle du Conseil est ronde, comme une bulle : personne n'est jamais au bout de la table."],
			[["conseil", "À quoi sert le Conseil des Marées ?", ["Il décide de tout ce qui se partage : l'air de la Cheminée, l'eau douce, les lumières, les places à l'école. La Présidente Ondine Nacre écoute tout le monde, puis elle décide. Ensuite, elle réécoute tout le monde. Pour être sûre."]],
			["demandes", "Quelles demandes recevez-vous ?", ["Depuis la réouverture de la Ligne : cent douze demandes de visite, quarante lettres d'en haut, et une pétition des enfants pour que la Grande Chanteuse ait son propre jour férié. La Présidente l'étudie très sérieusement."]]]]}],
