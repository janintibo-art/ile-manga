static func complete(d: Dictionary) -> Dictionary:
	var out: Dictionary = d.duplicate(true)
	var rep: Dictionary = out.get("repliques", {})
	for k in COMMON:
		if not rep.has(k):
			rep[k] = COMMON[k]
	out["repliques"] = rep
	for k in ["prefixes", "tics", "humeur_mots", "surnoms"]:
		if not out.has(k):
			out[k] = BASE[k]
	if not out.has("compagnon_lignes"):
		out["compagnon_lignes"] = []
	if not out.has("traits"):
		out["traits"] = {"bavard": 0.6, "humour": 0.5, "curiosite": 0.5, "susceptible": 0.3, "rancunier": 0.3}
	out["groupe"] = "azur"
	return out


