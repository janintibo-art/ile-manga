extends RefCounted
## V114 : les passants de la Fronde, le quartier libre des Strates : [style, rôle, [deux phrases]] (même forme
## que les PASSANTS de hautefond_v112.gd et de nuees_passants_v113.gd). Style « fronde » (des Frondeurs :
## crêtes de couleur, cuir, bleus de chauffe, comme les passants de Port-Boucan) ; rôle : homme | femme |
## vieux | vieille | enfant.

const PASSANTS := [
	["fronde", "homme", ["La Ligne a rouvert ! Hier, un monsieur d'en haut a traversé le Pont des Frondeurs en se tenant à moi. Je ne le connaissais pas. Maintenant, si.", "Ce soir, les Soupapes jouent à vingt heures. Comme hier. Comme demain. Et c'est toujours la première fois."]],
	["fronde", "femme", ["J'ai déposé une lampe cassée au Troc ce matin. Ce soir, elle éclaire la passerelle de Bricole. Tout finit par servir, ici.", "Mon conteneur est bleu dehors, jaune dedans, et il y a une fresque de Fusain sur le toit. Personne ne la voit. Sauf moi. Et la voûte."]],
	["fronde", "vieux", ["J'ai connu la Fronde quand ce n'était qu'une décharge et un feu dans une brouette. Le feu est toujours là. Moi aussi. La brouette, Fusain l'a peinte sur le Mur.", "Ma crête est grise, maintenant. Je l'avais choisie violette à quinze ans. Elle a fané. Mais elle tient toujours debout. Comme moi."]],
	["fronde", "vieille", ["La potée de Gamelle, je la mange tous les midis depuis vingt-cinq ans. Elle n'est jamais pareille. Gamelle dit que c'est la louche qui décide.", "Les gens d'en haut demandent combien coûte un bol à la Cantine Libre. On leur répond : « Combien tu as dans le cœur ? » Ils fouillent leurs poches. C'est mignon."]],
	["fronde", "enfant", ["Ressort est descendu au Dôme d'Azur avec sa planche ! Il voulait rouler dans la galerie de verre. La maîtresse d'en bas a dit non. Il dit qu'un jour, il fera une rampe des Nuées jusqu'au Dôme. Il le dit tous les jours.", "Plus tard, je jouerai de la batterie pour la baleine du Dôme, comme Rivet. Ou je serai baleine. Je n'ai pas encore choisi."]],
	["fronde", "homme", ["Les rails du Funiculaire d'Azur, au fond de la mer, c'est Rivet et Bielle qui les ont posés. La dernière traverse est violette. Le chef de gare d'en bas fait « boum-tchak » chaque fois qu'il passe dessus. La Fronde a de l'influence.", "Je suis descendu au Dôme, hier. Là-bas, on se dit « Bonnes bulles ! ». J'ai répondu « Boum-tchak ! ». Ils ont trouvé ça très poli."]],
	["fronde", "enfant", ["J'ai vu Ressort traverser le Pont en skate ! Très doucement. Brasero a fait semblant de ne pas regarder. Il regardait.", "Quand j'aurai quinze ans, je choisirai le vert, comme Bielle. Ou l'orange, comme Brasero. Ou les deux. Je vais demander à l'Assemblée."]],
	["fronde", "homme", ["Je travaille à la Grande Forge des Strates, le jour. Le soir, je traverse le Pont pour le concert. Ma femme dit que je change de monde deux fois par jour.", "Les gens des Strates disent qu'on fait trop de bruit. Puis à vingt heures, ils sont tous dans la fosse. Et à vingt-trois heures, ils réclament un dernier morceau."]],
	["fronde", "femme", ["L'Assemblée a duré quatre heures, hier soir. On a voté la couleur de la nouvelle guirlande. Rose. Et le nom du nouveau canapé : « Gaston ». Il a l'air d'un Gaston.", "Écho m'a dit bonjour, ce matin. Un mot entier ! Je l'ai raconté à toute la Cantine."]],
	["fronde", "enfant", ["Au Skatepark, il y a la Baleine, le Bol, et le Tunnel de la Mort Pas Grave. Moi, je fais seulement le Bol. Pour l'instant.", "Une dame d'en haut avait un chapeau à plume. Elle l'a échangé au Troc contre un collier de boulons ! Lumi en a fait un abat-jour. Le chapeau, pas la dame."]],
	["fronde", "vieux", ["J'étais mineur, aux Mines de Cristaux. Maintenant, je répare des chaises à l'Atelier Libre. Bricole dit que je tape trop fort. C'est l'habitude.", "Le Soleil de Laiton baisse, là-bas, dans les Strates. Ici, on n'a pas de soleil. On a les guirlandes, les cristaux et le brasero. Ça suffit à un vieux bonhomme."]],
	["fronde", "femme", ["Ma fille est montée à Hautefond voir le ciel. Elle est revenue en disant : « C'est grand, mais il n'y a pas d'écho. » Elle a raison. Ici, tout répond.", "Le Mur des Fresques a un nouveau bout : un pont, une cabine, et des gens d'en haut avec des chapeaux. Fusain dit que c'est la suite de l'histoire."]],
	["fronde", "homme", ["Je suis descendu de Hautefond pour voir « les punks d'en bas ». Une vieille dame m'a servi de la potée, un gamin m'a appris à dire « même pas mal », et j'ai voté à une Assemblée. Je ne sais plus pourquoi j'avais peur.", "Bon, j'ai une crête en papier, pour ce soir. Rivet m'a dit que ça comptait. À moitié."]],
	["fronde", "vieille", ["La Ligne du Dôme d'Azur, au fond, a enfin rouvert. Moi, je n'ai jamais vu la mer. Je la verrai d'abord par en dessous. C'est plus original.", "Ici, tout est à prix libre ou au troc. J'ai échangé un pot de confiture contre une chanson de Bielle. Je crois que j'ai fait une excellente affaire."]],
	["fronde", "enfant", ["Tom, l'apprenti de la Forge des Strates, est venu au Skatepark ! Il est tombé quatre fois. Il a dit « même pas mal » quatre fois. Il apprend vite.", "Si tu parles tout bas près du Mur des Fresques, on t'entend à la Cantine. Mémé Gamelle sait tout. Mais elle ne répète rien. Elle le met dans la soupe."]],
	["fronde", "homme", ["Les gens d'en haut arrivent avec des chapeaux et repartent avec des boulons aux oreilles. Lumi dit que c'est l'effet Fronde.", "Ce matin, sur le Pont, j'ai crié mon prénom au Gouffre. Il me l'a renvoyé trois fois. Je ne savais pas que j'avais un si joli prénom."]],
]
