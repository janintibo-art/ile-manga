extends RefCounted
## V114 : les passants des Strates : [style, rôle, [deux phrases]] (même forme que les PASSANTS de
## hautefond_v112.gd et de nuees_passants_v113.gd). Style « montjoie » (le même costume que les gens de
## Hautefond) ; rôle : homme | femme | vieux | vieille | enfant. Des mineurs, des forgerons, des
## lampistes, des cheminots, des marchandes, des enfants, une vieille dame des Galeries…

const PASSANTS := [
	["montjoie", "homme", ["Je sors de la mine. J'ai du grès jusque dans les oreilles et des étoiles bleues plein les yeux. Bonne journée, quoi.", "Le contremaître Ludovic m'a fait vérifier mon casque trois fois ce matin. Il était bien attaché. Il l'est encore plus, maintenant."]],
	["montjoie", "femme", ["La Ligne a rouvert ! Ma sœur est descendue d'en haut avec un parapluie. Ici ! Je lui ai montré la cascade. Elle l'a ouvert quand même.", "Le Soleil de Laiton est bien fort, aujourd'hui. Les lampistes ont dû tourner la manivelle un tour de trop. On ne s'en plaint pas."]],
	["montjoie", "vieux", ["De mon temps, la Ligne était déjà fermée pour travaux. Et du temps de mon père, elle était ouverte. Je suis content d'avoir vécu assez longtemps pour boucler la boucle.", "Tu entends la Grande Forge ? Boum… boum… C'est le marteau-pilon. Brunehaut l'appelle Grand-Mère. Moi, il me berce."]],
	["montjoie", "vieille", ["J'habite la deuxième galerie depuis soixante ans. De mon balcon, je vois toute la caverne. Et je sais qui rentre tard. Ne t'inquiète pas, je ne dis rien. Presque rien.", "Honorine m'a encore servi un bol de plus. Je n'avais pas faim. Je l'ai fini quand même. C'est la règle, chez elle."]],
	["montjoie", "enfant", ["J'ai couru à côté de Bernadette pendant tout un tour ! Papy Ferdinand a fait semblant de ne pas pouvoir me rattraper !", "Quand je serai grand, je serai mineur. Ou cristal. Je n'ai pas encore choisi."]],
	["montjoie", "homme", ["Je suis cheminot. Je répare les aiguillages du Petit Train. Si tu entends un « clac », c'est moi. Si tu entends « aïe », c'est moi aussi.", "Les gens d'en haut s'étonnent que notre train tourne en rond. Moi, je m'étonne que leurs cabines montent tout droit. Pas de virages ! Quel ennui."]],
	["montjoie", "femme", ["Je suis lampiste à l'Atelier des Lumières. Aujourd'hui, j'ai fait trois lanternes. La Docteure Opaline en a commencé une et en a oublié deux. C'est une bonne journée.", "Ce soir, c'est moi qui baisse le Soleil de Laiton. Quarante tours de manivelle. Je compte à voix haute. Toute la caverne compte avec moi."]],
	["montjoie", "enfant", ["Ma grande sœur dit qu'en haut, le soleil est si fort qu'on ne peut pas le regarder. Ici, on le regarde tant qu'on veut ! Bonjour, Soleil !", "J'ai trouvé un éclat de cristal près des rails. Il brille dans ma poche. Ma maman dit que c'est pour ça que mon pantalon est bleu."]],
	["montjoie", "homme", ["La grille du Dôme d'Azur a rouvert, au bout du quai de la Gare ! J'ai pris la cage de laiton, puis la bulle de verre. Une raie est passée sous mes pieds. J'ai tenu mon casque à deux mains. Au cas où.", "Anatole a huilé cette grille tous les soirs pendant douze ans. Maintenant, elle s'ouvre trente fois par jour, et il l'huile encore. Par habitude."]],
	["montjoie", "vieille", ["Ma petite-fille m'a emmenée au Dôme d'Azur. Ils ont un soleil, là-bas, eux aussi : une grosse perle. Le soir, elle devient violette. Le nôtre devient couleur miel. Chacun ses goûts.", "Au fond de la mer, ils disent « Bonnes bulles ! » pour dire bonjour. Je l'ai essayé à La Marmite. Honorine m'a resservi un bol. Elle a cru que j'avais faim."]],
	["montjoie", "homme", ["Je suis forgeron. Ce matin, j'ai entendu Maîtresse Brunehaut taper deux coups, puis un. Et quelqu'un a répondu, d'en haut. Ça me donne des frissons à chaque fois.", "La Fronde nous a encore emprunté une pince pour le concert. Ce soir, si tu entends une enclume qui chante, c'est la nôtre."]],
	["montjoie", "vieille", ["Je vends des galettes au coin de la Place des Rouages depuis quarante ans. La Marmite d'Honorine est juste à côté. On ne se fait pas concurrence : on se fait des clins d'œil.", "Les jeunes d'en haut ouvrent de grands yeux devant les Jardins des Champignons. Tant mieux. Les grands yeux, c'est comme les lanternes : ça éclaire."]],
	["montjoie", "femme", ["Je pousse les wagonnets de la mine. Un wagonnet plein de cristaux, ça brille tellement qu'on n'a pas besoin de lampe pour rentrer.", "Le petit Tom attend encore sur le banc de la Gare. Il dit qu'il ne guette personne. Il a mis sa plus belle chemise."]],
	["montjoie", "vieux", ["La Grande Horloge des Strates sonne toujours une seconde après celle d'en haut. Exprès, paraît-il : pour laisser au son le temps de descendre.", "Le soir, du balcon, j'écoute la musique de la Fronde, de l'autre côté du Pont. Je ne danse plus. Mais mes pieds, si. Tout seuls."]],
	["montjoie", "enfant", ["J'ai tapé deux coups, puis un, sur le mur de l'école. Personne n'a répondu. Tom dit qu'il faut taper sur la bonne roche.", "J'ai écouté la cascade avec Bertille. Elle dit qu'il pleut en haut. Moi, je n'ai jamais vu la pluie tomber du ciel. Juste du plafond."]],
	["montjoie", "femme", ["Je suis montée à Hautefond par la Ligne, hier, pour la première fois. Il y a du vent ! Partout ! Et le plafond est très haut. Bleu, même.", "Au Grand Marché d'en haut, j'ai vu les bijoux d'Ysaé. Avec nos cristaux dedans ! J'ai dit à tout le monde : « Ça vient de chez moi ! »"]],
]
