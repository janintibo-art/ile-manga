extends RefCounted
## V53 : zones « métal » (clous, pointes, chaînes) de la texture du héros, 512 x 512,
## 1 bit par pixel, ligne par ligne (généré par pcvr/tools/generate_pnj_v53.py).

const SIZE: int = 512
const DATA: String = ""

static var _bytes: PackedByteArray = PackedByteArray()


## Vrai si le point de texture (u, v) tombe sur du métal.
static func is_metal(uv: Vector2) -> bool:
	if _bytes.is_empty():
		_bytes = Marshalls.base64_to_raw(DATA)
	var x: int = clampi(int(fposmod(uv.x, 1.0) * SIZE), 0, SIZE - 1)
	var y: int = clampi(int(fposmod(uv.y, 1.0) * SIZE), 0, SIZE - 1)
	var i: int = y * SIZE + x
	return (_bytes[i >> 3] >> (7 - (i & 7))) & 1 == 1
