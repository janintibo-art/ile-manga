				"lui": [L("Mon maître racontait sur cette place, et son maître avant lui. Les mots ne meurent pas tant qu'on les dit. Moi, je les dis.", {}), L("Les pirates viennent écouter, le soir. Ils font semblant de passer par hasard. Les pirates aiment les histoires plus que tout le monde : ils en vivent une.", {"sujet_min": ["lui", 1]})],
				"ile": [
					L("Écoute. Avant Tazira, avant Carène, avant tout, l'île était une seule montagne, et la montagne avait un cœur. Quatre peuples gardaient quatre portes. Puis les portes se sont fermées, et il n'en reste qu'une.", {}),
					L("Quatre sceaux pour la dernière porte. Le désert garde le sien sous une dune qui marche. Pour la trouver, dit-on, il faut suivre les étoiles qui marchent. … Les lanternes des caravanes, peut-être. Ou autre chose.", {"sujet_min": ["ile", 1]}),
				],
				"rumeur": [L("Il y a longtemps, un pirate a caché un trésor dans les grottes derrière la Skala. Un autre pirate, son petit-fils peut-être, est revenu le chercher. Les histoires reviennent toujours.", {})],
				"interpelle": [L("Une histoire, voyageur ?", {"visites_max": 0}), L("{surnom} ! Assieds-toi dans le cercle !", {"visites_min": 1})],
			}},
