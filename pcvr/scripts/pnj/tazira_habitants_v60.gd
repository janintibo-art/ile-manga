			"repliques": {
				"accueil": [L("Ho ho ! Un client ! Jacquot Trois-Doigts, maître-coq de la Murène Noire. Trois doigts, parce que les deux autres sont dans une soupe, quelque part dans l'océan. Elle était très bonne.", {"visites_max": 1}, "rire"), L("Ho ho ! Tu as faim ? J'ai un ragoût de… de quelque chose.", {"visites_min": 2}, "rire")],
				"humeur": [L("Splendide ! Ce soir, je danse ! J'adore danser. Les gens de Tazira disent que je danse comme une baleine. C'est un compliment, les baleines sont gracieuses.", {}, "rire")],
				"lui": [L("Trente ans que je nourris des pirates. Personne n'est jamais mort de ma cuisine. Enfin, personne qui s'en soit plaint.", {}, "rire"), L("Ici, j'ai découvert le tajine. Zohra m'a appris. Enfin, elle m'a regardé faire et elle a pleuré. De joie, je crois.", {"sujet_min": ["lui", 1]}, "rire")],
