static func L(t: String, si: Dictionary = {}, geste: String = "") -> Dictionary:
	return Azur.L(t, si, geste)


static func complete(d: Dictionary) -> Dictionary:
	var out: Dictionary = d.duplicate(true)
	var pirate: bool = bool(out.get("pirate", false))
	var common: Dictionary = COMMON_PIRATE if pirate else COMMON
	var base: Dictionary = BASE_PIRATE if pirate else BASE
	var rep: Dictionary = out.get("repliques", {})
	for k in common:
		if not rep.has(k):
			rep[k] = common[k]
	out["repliques"] = rep
	for k in ["prefixes", "tics", "humeur_mots", "surnoms"]:
		if not out.has(k):
			out[k] = base[k]
	out = Azur.complete(out)
	out["groupe"] = "tazira"
	return out


