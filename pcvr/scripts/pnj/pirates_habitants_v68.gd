			"aime": {"minerai_fer": 2.0, "rhum_murene": 2.0}, "deteste": {"punch_coco": -1.0},
			"pirate": {"equipage": "morue", "role": "maître d'équipage", "pv": 9, "force": 1, "crochet": true, "joueur": true, "mise_max": 10, "provocs": ["vue", "odeur", "navire"],
				"point_sensible": {"label": "Avec ton crochet, tu te grattes comment le nez ?", "t": "(Il approche lentement son crochet de ton nez.) Comme ça. Tu veux que je te montre comment je me gratte l'oreille ? Ou plutôt… comment je gratte la TIENNE ?"}},
