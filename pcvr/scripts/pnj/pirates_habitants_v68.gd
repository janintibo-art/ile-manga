				"ile": [L("Tous les pirates de la Balafre portent ma marque, quelque part. Même le Muet. Surtout le Muet : il a un petit cœur sur le bras. Ne lui dis pas que je te l'ai dit.", {})],
				"rumeur": [L("Scarlett est venue faire tatouer un couteau. Elle a bougé. C'est devenu une cuillère. Elle ne m'a pas encore pardonné.", {}, "rire")],
				"interpelle": [L("Hé, toi ! Belle peau !", {"visites_max": 0}), L("{surnom} ! Un tatouage ?", {"visites_min": 1})],
			}},
