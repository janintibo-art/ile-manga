			"pirate": {"equipage": "port", "role": "conteur", "pv": 5, "force": 1, "pacifique": true, "provocs": ["dents", "vue"],
				"point_sensible": {"label": "Tes histoires, tu les inventes, avoue.", "t": "Inventer ? MOI ? J'ai navigué avec Barbe-Sanglante ! J'ai vu le Kraken ! J'ai dansé avec une sirène ! … Elle dansait mal, d'ailleurs. Tu me traites de menteur, mousse ?"}},
			"repliques": {
				"accueil": [L("Approche, approche… Assieds-toi près du feu. Silas. Le Vieux Silas. Le dernier homme vivant de l'équipage de Barbe-Sanglante. Tu veux une histoire ? J'en ai mille. Toutes vraies. Presque.", {"visites_max": 1}), L("Ah, {surnom}… Tu reviens écouter le vieux Silas ?", {"visites_min": 2})],
				"humeur": [L("Vieux. Mais content. Tant qu'il y a du rhum et quelqu'un pour écouter, Silas est content.", {})],
				"lui": [L("Barbe-Sanglante… Le plus grand pirate de tous les temps. Il a coulé cent navires et n'a jamais perdu une bataille. Il a perdu son trésor, par contre. Enfin, il l'a caché si bien qu'il ne l'a jamais retrouvé.", {}), L("Le second de Barbe-Sanglante, le Capitaine Sans-Chair, a juré de garder le trésor pour l'éternité. Il a tenu parole. Il est encore là-bas. Enfin, ce qu'il en reste.", {"sujet_min": ["lui", 1]})],
				"ile": [L("La carte du trésor ? Barbe-Sanglante l'a déchirée en trois, pour que ses hommes ne se trahissent pas. Un morceau est dans le mausolée, au cimetière. Un autre dans le donjon du Fort Maudit. Le troisième… on dit que Sylvain, le croupier, le garde dans sa manche.", {})],
				"rumeur": [L("Les squelettes du fort ? Les hommes de Barbe-Sanglante. Ils gardent encore le fort, comme on le leur a ordonné il y a cent ans. Des soldats fidèles. Et très maigres.", {}, "rire")],
				"interpelle": [L("Une histoire, mousse ?", {"visites_max": 0}), L("{surnom}… Approche.", {"visites_min": 1})],
