			"repliques": {
				"accueil": [L("Salut, l'ami ! Tom le Violoneux ! Je joue au Crâne Fendu tous les soirs. Les gigues, les complaintes, et la Chanson du Roi de la Bagarre. Tu la connais ? Elle n'a pas encore de couplet final : personne n'a encore battu les trois champions.", {"visites_max": 1}, "salut"), L("{surnom} ! Viens ce soir au Crâne Fendu, j'ai écrit un nouveau couplet !", {"visites_min": 2})],
				"humeur": [L("Joyeux ! La musique me rend joyeux. Le grog aussi. Les deux ensemble, c'est le paradis.", {}, "rire")],
				"lui": [L("J'ai joué pour un roi, une fois. Il a pleuré. Puis il m'a jeté dehors parce que j'avais joué à son mariage la chanson de son ancienne fiancée. Les rois n'ont pas d'humour.", {}, "rire")],
				"ile": [L("Je tiens le tableau des cogneurs, au Crâne Fendu : Gros-Louis du Requin Borgne, le Muet de la Veuve Écarlate, et Belle-Humeur de la Morue Enragée. Les trois champions du port. Bats-les tous les trois, à la loyale, et je chanterai ta gloire.", {})],
				"rumeur": [L("La nuit, quand je rentre, j'entends des os qui claquent du côté du cimetière. Je joue plus fort. Ça ne marche pas, mais ça me rassure.", {})],
				"interpelle": [L("Hé, l'ami ! Tu aimes la musique ?", {"visites_max": 0}), L("{surnom} ! La la la !", {"visites_min": 1})],
			}},
