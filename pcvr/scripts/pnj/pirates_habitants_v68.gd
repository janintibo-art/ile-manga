			"pirate": {"equipage": "port", "role": "marchand", "pv": 6, "force": 1, "pacifique": true, "provocs": ["perroquet"],
				"point_sensible": {"label": "Tes perroquets, ils disent que des gros mots.", "t": "Des gros mots ?! Mes perroquets sont ÉDUQUÉS ! Ils disent « bonjour », « merci », et « à l'abordage » ! … Bon, Bartholomé dit aussi « tête de méduse ». Mais c'est affectueux !"}},
			"repliques": {
				"accueil": [L("Approchez, approchez ! Perroquet-Joe ! Les plus beaux perroquets de l'archipel ! Ils parlent, ils sifflent, ils chantent ! Un pirate sans perroquet, c'est un marin sans mer !", {"visites_max": 1}, "rire"), L("{surnom} ! Bartholomé t'a reconnu ! Il dit « bonjour » ! … Non, il dit « tête de méduse ». Mais il t'aime bien.", {"visites_min": 2}, "rire")],
				"humeur": [L("Merveilleux ! Mes oiseaux chantent, le soleil brille, et personne ne s'est encore battu près de mon étal aujourd'hui !", {}, "rire")],
				"lui": [L("J'ai appris à parler aux perroquets avant de parler aux gens. Les perroquets sont plus faciles : ils répètent tout, ils ne discutent jamais.", {}, "rire")],
				"ile": [L("Dans la jungle, il y a des perroquets sauvages, des rouges et des bleus. La capitaine Anne-Rose avait un rouge, Rhubarbe. Il s'est envolé vers le vieux camp abandonné, au nord. Je l'ai entendu jurer là-bas.", {})],
				"rumeur": [L("Un perroquet, ça vit cent ans ! Bartholomé a connu Barbe-Sanglante. Il répète parfois « le crâne, le crâne ». Je ne sais pas ce que ça veut dire.", {})],
				"interpelle": [L("Un perroquet ? Un perroquet ?", {"visites_max": 0}), L("{surnom} ! Viens voir mes oiseaux !", {"visites_min": 1})],
			}},
