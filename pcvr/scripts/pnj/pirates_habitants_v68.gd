			"repliques": {
				"accueil": [L("Salut ! Tu es nouveau ? Moi c'est Petit-Pierre, le mousse du Requin Borgne ! Je sais grimper au mât, nettoyer le pont, et faire des nœuds ! Pas tous. Mais beaucoup !", {"visites_max": 1}, "salut"), L("{surnom} ! Tu as vu ? J'ai attrapé un poisson ! Il était petit. Je l'ai relâché. Il grandira.", {"visites_min": 2}, "rire")],
				"humeur": [L("Génial ! Gros-Louis m'a appris à faire un poing ! Mais la capitaine dit que je n'ai pas le droit de m'en servir. Alors je le garde dans ma poche.", {}, "rire")],
				"lui": [L("Je ne me bats pas, moi. La capitaine l'a dit : « Le mousse ne se bat pas. » Alors quand il y a une bagarre, je compte les coups. Hier, j'en ai compté quarante-trois.", {})],
				"ile": [L("Tu sais ce qui est le plus beau, ici ? Le coucher de soleil derrière les mâts. Et le plus effrayant : le Rocher du Crâne. Je l'ai vu une fois, de loin. Ses yeux brillaient.", {})],
				"rumeur": [L("Le perroquet de la capitaine s'est envolé ! Il s'appelle Rhubarbe. Il dit des gros mots. Si tu l'entends dire des gros mots dans la jungle, c'est lui !", {"q56": "bal_perroquet="}), L("Perroquet-Joe dit que ses perroquets sont polis. Ils m'ont traité de « marin d'eau douce ». C'est poli, ça ?", {})],
