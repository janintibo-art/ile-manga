			"tz": {"tricorne": [0.3, 0.2, 0.1], "boucle": true},
			"teinte": PEAU[3], "humeur_base": 0.4, "traits": {"bavard": 0.9, "humour": 0.8, "curiosite": 0.6, "susceptible": 0.45, "rancunier": 0.5},
			"aime": {"piece_or": 3.0, "rubis": 2.5, "des_pipes": 2.0}, "deteste": {"caillou": -1.0},
			"pirate": {"equipage": "morue", "role": "capitaine", "pv": 8, "force": 1, "joueur": true, "mise_max": 20, "provocs": ["navire", "capitaine", "dents"],
				"point_sensible": {"label": "Elles sont vraies, tes dents en or, ou c'est du laiton ?", "t": "Du LAITON ?! (Il te montre ses dents, toutes en or, qui brillent.) Vingt-deux carats ! Chacune ! Tu sais combien de gouverneurs j'ai plumés pour cette mâchoire ? Retire ça, mon mignon. Tout de suite."}},
			"repliques": {
				"accueil": [L("Mon ami ! Ignace Malaterre, capitaine de la Morue Enragée, le sloop le plus élégant de l'archipel. On m'appelle Bouche-d'Or. (Il sourit. Toutes ses dents sont en or.) Tu joues aux dés ? Non ? Dommage. Tu joueras.", {"visites_max": 1}, "rire"), L("Ah, {surnom} ! Toujours ravi de voir une bourse pleine. Pardon : un ami.", {"visites_min": 2}, "rire")],
				"humeur": [L("Excellente ! J'ai gagné un chapeau, deux chèvres et un gouverneur aux dés, cette semaine. Le gouverneur, je l'ai rendu. Il mangeait trop.", {}, "rire")],
				"lui": [L("La Morue Enragée, je l'ai gagnée aux dés contre un amiral. Il avait trois six. Moi aussi. Mais les miens étaient plus… convaincants.", {}, "rire"), L("Les dents ? Une à chaque victoire. Il ne m'en reste plus de vraies. C'est dire si je gagne.", {"sujet_min": ["lui", 1]})],
				"ile": [L("La Dent du Requin, c'est le seul endroit civilisé de cette île. On y perd son argent avec élégance. Sylvain, le croupier, a des doigts d'argent et un cœur de pierre.", {})],
				"rumeur": [L("Sylvain garde un bout de parchemin dans sa manche, à la grande table. Un morceau de carte, dit-on. Il ne le mise que contre un joueur qui le bat trois fois d'affilée. Personne n'y est arrivé.", {})],
				"interpelle": [L("Psst ! Une petite partie ?", {"visites_max": 0}), L("{surnom}, mon ami ! Une partie ?", {"visites_min": 1})],
			}},
