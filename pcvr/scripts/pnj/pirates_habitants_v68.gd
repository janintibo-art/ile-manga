				"point_sensible": {"label": "Personne n'a voté pour toi, « Gouverneur ».", "t": "PERSONNE ?! Moi j'ai voté ! Et personne n'a voté contre ! C'est une élection à l'unanimité ! … Gardes ! GARDES ! … Ah, c'est vrai, je n'ai pas de gardes. Bon. Je vous ai à l'œil, citoyen."}},
			"repliques": {
				"accueil": [L("Ah ! Un visiteur ! Bienvenue à Port-Coutelas, cité libre, prospère et ordonnée ! Je suis le Gouverneur Lagrange. Si vous avez des doléances, écrivez-les. Je ne les lirai pas, mais écrivez-les.", {"visites_max": 1}, "salut"), L("Citoyen {surnom} ! Toujours un plaisir. Avez-vous payé vos impôts ? … Ah, c'est vrai, il n'y a pas d'impôts. Dommage.", {"visites_min": 2})],
				"humeur": [L("Excellente ! Port-Coutelas n'a jamais été aussi bien gouverné. Il n'a d'ailleurs jamais été gouverné du tout avant moi.", {}, "rire")],
				"lui": [L("J'étais percepteur d'impôts. Un jour, des pirates ont abordé mon navire. Ils m'ont pris tout l'argent, puis m'ont trouvé si bavard qu'ils m'ont déposé ici. J'ai décidé que, puisque personne ne gouvernait, ce serait moi.", {})],
				"ile": [L("Mon programme : des lanternes sur le quai, un ponton neuf, et l'interdiction des bagarres le dimanche. Les lanternes, c'est fait. Le reste… les pirates sont des citoyens difficiles.", {})],
				"rumeur": [L("Entre nous, citoyen : Mama Grog a plus d'autorité que moi. Mais ne le répétez pas. Surtout pas à elle.", {})],
				"interpelle": [L("Citoyen ! Citoyen !", {"visites_max": 0}), L("Citoyen {surnom} !", {"visites_min": 1})],
			}},
