			"repliques": {
				"accueil": [L("Fulbert Saignée. Doc, pour les intimes. Chirurgien, barbier, dentiste, et parfois vétérinaire quand Joe m'amène un perroquet enrhumé. Tu es blessé ? Non ? Ça viendra. Ici, ça vient toujours.", {"visites_max": 1}), L("Ah, {surnom}. Tu as encore tous tes doigts ? Bien.", {"visites_min": 2}, "rire")],
				"humeur": [L("Débordé. La fièvre des marais a pris la moitié de l'équipage de la Veuve. Il me faudrait des herbes du marais. Mais le marais, c'est plein de crocodiles.", {"q56": "bal_fievre="})],
				"lui": [L("J'étais chirurgien de la marine royale. Un jour, j'ai soigné un pirate. Puis deux. Puis la marine m'a renvoyé. Les pirates, eux, m'ont gardé.", {})],
