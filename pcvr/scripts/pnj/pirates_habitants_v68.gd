			"pirate": {"equipage": "port", "role": "tatoueuse", "pv": 8, "force": 1, "provocs": ["vue", "odeur"],
				"point_sensible": {"label": "Le poulpe de Tonneau, on dirait un cheval.", "t": "UN CHEVAL ?! C'est un poulpe ! Huit bras ! Huit ! … Bon, il bouge pendant que je dessine. C'est un mauvais client. Mais ne critique pas mon art, ou je te tatoue une sardine sur le front."}},
			"repliques": {
				"accueil": [L("Coralie l'Encre. Je tatoue les durs. Les ancres, les sirènes, les têtes de mort. Tu veux un tatouage ? Les pirates respectent ceux qui en ont un.", {"visites_max": 1}), L("{surnom}. Alors, ce tatouage ?", {"visites_min": 2})],
