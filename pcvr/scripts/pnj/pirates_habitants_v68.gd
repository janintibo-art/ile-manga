			"pirate": {"equipage": "veuve", "role": "matelot", "pv": 6, "force": 1, "joueur": true, "mise_max": 5, "provocs": ["dents", "nage", "odeur"],
				"point_sensible": {"label": "Il t'en reste combien, des dents ?", "t": "Deux ! Et elles sont TRÈS fiffiles ! Tu veux que fe te morde avec, pour foir ?!"}},
			"repliques": {
