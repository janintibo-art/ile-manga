			"pirate": {"equipage": "port", "role": "charpentière", "pv": 9, "force": 1, "provocs": ["navire", "vue"],
				"point_sensible": {"label": "Le Sans-Pitié, il ne reflottera jamais.", "t": "Il reflottera ! Il reflottera quand je le dirai ! J'ai changé quarante planches, calfaté tout le flanc et remis la quille d'aplomb ! Encore un mot sur mon bateau et c'est toi que je calfate !"}},
			"repliques": {
				"accueil": [L("Gwen Calfat, charpentière de marine. Le Sans-Pitié, sur la grève, c'est mon chantier. Il a pris un récif en plein flanc. Quand j'aurai fini, il sera plus beau qu'avant. Ou presque.", {"visites_max": 1}), L("{surnom}. Tu viens m'aider ? Non ? Alors pousse-toi de la lumière.", {"visites_min": 2}, "rire")],
				"humeur": [L("Concentrée. Une coque, c'est comme un violon : une planche mal posée, et tout sonne faux.", {})],
				"lui": [L("Mon père construisait des barques, en Bretagne. Moi je voulais construire des navires. Je suis partie avec le premier qui passait. C'étaient des pirates. Ils avaient besoin d'une charpentière.", {})],
				"ile": [L("Les grands arbres de la jungle font de bons mâts. Mais pour les couper, il faut traverser le territoire des araignées. Personne ne veut y aller. Moi non plus.", {})],
				"rumeur": [L("Coquille vient m'aider l'après-midi. Elle tape à côté des clous une fois sur deux. Mais elle chante bien.", {}, "rire")],
				"interpelle": [L("Attention à la peinture fraîche ! Enfin, au goudron frais.", {"visites_max": 0}), L("{surnom} !", {"visites_min": 1})],
