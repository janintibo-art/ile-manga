				"point_sensible": {"label": "Tes cartes, c'est des gribouillis d'enfant.", "t": "DES GRIBOUILLIS ?! J'ai cartographié quarante îles, trois mers et un continent ! Le continent n'existait pas, d'accord, mais la carte était magnifique ! Sors de ma tour !"}},
			"repliques": {
				"accueil": [L("Bonjour, bonjour ! Philémon Lunette, cartographe. Je dessine les îles que les autres découvrent. C'est moins dangereux. Bien que… cette île-ci m'a coûté trois plumes et un orteil.", {"visites_max": 1}, "salut"), L("Ah, {surnom} ! Vous… tu as vu quelque chose d'intéressant ? Une crique, un rocher, un trésor ?", {"visites_min": 2})],
				"humeur": [L("Inspiré ! Le ciel est clair. De ma tour, je vois jusqu'à Arcanelle, quand la brume se lève.", {})],
				"lui": [L("Je suis venu ici pour cartographier la Balafre. Il y a trente ans. Je n'ai toujours pas fini. L'île change. Les arbres poussent, les rochers bougent. Les squelettes aussi.", {})],
				"ile": [L("La carte de Barbe-Sanglante ? Elle existe. Je l'ai vue, jeune homme : déchirée en trois morceaux. Rassemblez-les, et je vous la recompose. Je sais lire les cartes de pirates : elles mentent toujours, mais toujours de la même façon.", {})],
				"rumeur": [L("Le Rocher du Crâne, au bout de la Balafre… J'ai voulu le dessiner de près. Ses yeux se sont allumés. J'ai dessiné très vite.", {})],
				"interpelle": [L("Bonjour !", {"visites_max": 0}), L("{surnom} ! Une nouvelle carte ?", {"visites_min": 1})],
			}},
