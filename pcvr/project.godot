; Les Mondes de Travers — édition PC VR native OpenXR (Meta Link et SteamVR)
config_version=5

[application]
config/name="Les Mondes de Travers VR V104"
config/icon="res://assets/textures/ui/les_mondes_de_travers_icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="IleManga"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.55, 0.82, 0.95, 1)

[xr]
openxr/enabled=true
openxr/startup_alert=false
openxr/reference_space=1
shaders/enabled=true

[physics]
common/physics_ticks_per_second=90

[shader_globals]

crayon_masque={
"type": "sampler2D",
"value": ""
}
crayon_rect={
"type": "vec4",
"value": Vector4(810, 1260, 380, 380)
}
crayon_soleil={
"type": "vec3",
"value": Vector3(0.4, 0.8, 0.45)
}
crayon_jour={
"type": "float",
"value": 1.0
}
crayon_vague={
"type": "vec4",
"value": Vector4(0, 0, -10, 4)
}
